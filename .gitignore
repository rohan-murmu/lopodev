# Tool binaries (installed locally, never committed)
.tools/

# Godot import/cache data
.godot/
*.godot/

# Build outputs
build/
projects/*/build/
projects/*/godot/build/

# Python
__pycache__/
*.py[cod]
.venv/
.pipeline_state.lock

# Temporary pipeline staging and install ownership
projects/*/godot/.pipeline/
.lopodev/
.loopdev/

# OS/editor noise
.DS_Store
*.swp

# Mobile and signing artifacts
*.apk
*.aab
*.keystore
*.jks
*.p12

# Regenerated PoC artifacts (tracked summaries keep the outcome)
projects/*/artifacts/previews/
projects/*/artifacts/logs/

# Generated adapter install targets (created by `lopodev install`)
.opencode/
.kilo/
.cursor/
.agents/

# Local agent tooling, not part of LopoDev
.codemap/
.claude/
.mcp.json
