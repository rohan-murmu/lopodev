#!/usr/bin/env bash
# LopoDev launcher and installer.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
VERSION="1.0.0"

usage() {
  cat <<'USAGE'
LopoDev - low-poly game development with OpenCode, Blender, and Godot

Usage:
  lopodev open [opencode args...]       Start OpenCode with the lopodev agent
  lopodev install <workspace>           Link the toolkit into a workspace
  lopodev install-cli [bin-dir]         Install this launcher (default ~/.local/bin)
  lopodev new --slug <slug> --title T   Bootstrap a project in the current folder
  lopodev verify [args...]              Run toolkit verification
  lopodev doctor                        Check the local toolchain
  lopodev version                       Print version and toolkit root
  lopodev help                          Show this help

Environment:
  LOPODEV_WORKSPACE   Workspace used by `lopodev new`
USAGE
}

cmd="${1:-open}"
if (($#)); then shift; fi

case "$cmd" in
  open)
    exec opencode --agent lopodev "$@"
    ;;
  install)
    exec "$ROOT/tools/install_lopodev.sh" "$@"
    ;;
  install-cli)
    bin_dir="${1:-$HOME/.local/bin}"
    target="$bin_dir/lopodev"
    mkdir -p "$bin_dir"
    if [[ -e "$target" && ! -L "$target" ]]; then
      echo "ERROR: $target exists and is not a symlink; not overwriting" >&2
      exit 2
    fi
    if [[ -L "$target" && "$(readlink -f "$target")" != "$SELF" ]]; then
      echo "ERROR: $target points elsewhere; not overwriting" >&2
      exit 2
    fi
    ln -sfn "$SELF" "$target"
    echo "INSTALLED_CLI=$target"
    echo "CLI_TARGET=$SELF"
    ;;
  new|init)
    workspace="${LOPODEV_WORKSPACE:-$PWD}"
    args=("$@")
    has_workspace=0
    for arg in "${args[@]:-}"; do
      [[ "$arg" == "--workspace" ]] && has_workspace=1
    done
    if [[ "$has_workspace" -eq 0 ]]; then
      args=(--workspace "$workspace" "${args[@]}")
    fi
    exec python3 "$ROOT/tools/bootstrap_project.py" "${args[@]}"
    ;;
  verify)
    exec "$ROOT/tools/verify_lopodev.sh" "$@"
    ;;
  doctor)
    exec "$ROOT/tools/check_env.sh" "$@"
    ;;
  version|--version|-v)
    echo "lopodev $VERSION"
    echo "root=$ROOT"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
